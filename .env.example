# ── App base URL (used to build the OAuth redirect URI) ───────────────────────
# Local dev:   http://localhost:7860
# Production:  https://nexus-placement-intelligence.hf.space
APP_BASE_URL=http://localhost:7860

# ── App access gate (M7 — replaces the old Basic Auth popup) ──────────────────
# A single shared username + password that protects every route. Visitors sign
# in at /login before the app loads. Leave BOTH unset to disable the gate
# (e.g. local dev). Distribute via a shared vault, never Slack or email.
APP_GATE_USER=
APP_GATE_PASS=
# Secret that signs the gate session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_GATE_SECRET=

# ── GSC fetch concurrency (M7 load-time lever) ────────────────────────────────
# Raised from M5's 8. Push to 24 on large account sets if the GSC API tolerates
# it without 429s. Defaults to 16 when unset.
GSC_MAX_WORKERS=16

# ── Google OAuth 2.0 Web client ────────────────────────────────────────────────
# Application type: Web application
# Authorized redirect URIs:
#   http://localhost:7860/api/auth/callback   (dev)
#   https://nexus-placement-intelligence.hf.space/api/auth/callback   (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session signing secret (HMAC — required; M4 item 5) ───────────────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── Upstash Redis (token + session store) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── HuggingFace Inference (BAAI/bge-base-en-v1.5 bi-encoder) ──────────────────
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── BigQuery warehouse (sole storage layer) ────────────────────────────────────
# Leave BQ_PROJECT_ID unset to run live-only (fetch + crawl every run).
BQ_PROJECT_ID=
BQ_DATASET_ID=
BQ_TABLE_ID=gsc_data
BQ_META_TABLE_ID=page_metadata
BQ_FEEDBACK_TABLE_ID=feedback

# Service-account JSON (BigQuery identity), pasted as a single-line string.
GCP_SERVICE_ACCOUNT_JSON=

# ── BigQuery strict writes (M7 testing aid) ───────────────────────────────────
# Set to 1/true during testing so any rejected streaming-insert row RAISES
# instead of being silently dropped. This surfaces the exact failure mode that
# historically made the GSC warehouse appear empty. Leave UNSET in production so
# a warehouse hiccup never fails a user's run.
BQ_STRICT_WRITES=
