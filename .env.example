# ── App access gate (HTTP Basic Auth — see middleware.ts) ─────────────────────
# A single shared username + password that protects the entire deployment.
# Leave BOTH unset to disable the gate (e.g. for local dev). When set in Vercel,
# every visitor is prompted for these before the app loads.
#   • Use a strong, randomly generated password — minimum 20 characters.
#   • Distribute via a shared vault (e.g. 1Password), never Slack or email.
#   • To rotate: change BASIC_AUTH_PASS in Vercel and redeploy.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ── App base URL (used to build the OAuth redirect URI) ───────────────────────
# Local dev:   http://localhost:3000
# Production:  https://<your-app>.vercel.app  (your stable Vercel alias)
APP_BASE_URL=http://localhost:3000

# ── Google OAuth 2.0 Web client (replaces the service account) ────────────────
# Create a "Web application" OAuth client in GCP, add the redirect URI:
#   <APP_BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Upstash Redis (token store) ───────────────────────────────────────────────
# Create a free Redis DB at upstash.com → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── HuggingFace Inference (BAAI/bge-base-en-v1.5 bi-encoder) ──────────────────
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── BigQuery warehouse (the sole storage layer — no Sheets fallback) ──────────
# Leave these unset to run live-only (fetch + crawl every run, nothing persisted).
# Set all three of BQ_PROJECT_ID, BQ_DATASET_ID, and GCP_SERVICE_ACCOUNT_JSON to
# activate BigQuery. See BIGQUERY_SETUP.md for the one-time provisioning steps.
BQ_PROJECT_ID=
BQ_DATASET_ID=
BQ_TABLE_ID=gsc_data
BQ_META_TABLE_ID=page_metadata

# Service-account JSON (the BigQuery identity), pasted as a single-line string.
# In Vercel, store it as a plain environment variable.
GCP_SERVICE_ACCOUNT_JSON=


# BigQuery feedback table name (default: "feedback"). Only set if you renamed it.
BQ_FEEDBACK_TABLE_ID=feedback
